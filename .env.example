# Server
PORT=3000
NODE_ENV=production

# Source website (the manga site this API scrapes)
SOURCE_URL=https://wurmz.net

# CORS
CORS_ORIGIN=*

# Rate limiting (requests per 15-minute window)
RATE_LIMIT_MAX=100

# Fetch
API_TIMEOUT=10000
MAX_RETRIES=3
MAX_CONCURRENT=3

# Cache TTLs (seconds)
CACHE_TTL_LIST=600
CACHE_TTL_DETAIL=3600
CACHE_TTL_CHAPTER=86400

# Base URL untuk API yang sudah di-deploy.
# Setelah deploy, isi dengan URL hasil deploy (contoh: https://your-host/api).
# Digunakan untuk dokumentasi & auto-detection oleh MANGA.
BASE_URL=https://your-host/api

# ---- FASE 3: Auto-Update System ----

# Sample URLs untuk health check (dipisah koma). Urutan: list, detail, reader.
# Jika kosong, health check akan resolve otomatis dari SOURCE_URL.
SAMPLE_URLS=

# GitHub auto-commit (untuk push selector yang diperbaiki otomatis).
# Gunakan Personal Access Token dengan scope "repo".
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Webhook notifications (opsional — dikirim saat selector rusak & tidak bisa
# auto-fix). Isi salah satu atau keduanya.
DISCORD_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
